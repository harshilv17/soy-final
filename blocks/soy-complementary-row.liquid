{%- liquid
  assign s = block.settings
  assign coll = s.collection
-%}

{% if coll != blank and coll.products_count > 0 %}
  <div class="soy-complementary spacing-style" style="{% render 'spacing-style', settings: s %}" {{ block.shopify_attributes }}>
    <div class="soy-complementary__head">
      <h3 class="soy-complementary__title">{{ s.heading | escape }}</h3>
      {% if s.view_all_link != blank %}
        <a href="{{ s.view_all_link }}" class="soy-complementary__link">{{ s.view_all_label | escape }}</a>
      {% endif %}
    </div>
    <div class="soy-complementary__track" role="list">
      {% for product in coll.products limit: s.limit %}
        <a class="soy-complementary__card" href="{{ product.url }}" role="listitem">
          <div class="soy-complementary__media color-{{ s.card_color_scheme }}">
            {% if product.featured_media %}
              {% assign comp_alt = product.featured_media.alt | default: product.title | escape %}
              {{
                product.featured_media
                | image_url: width: 400
                | image_tag:
                  loading: 'lazy',
                  widths: '200, 300, 400',
                  sizes: '140px',
                  alt: comp_alt,
                  class: 'soy-complementary__img'
              }}
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <p class="soy-complementary__card-title">{{ product.title | escape }}</p>
          <p class="soy-complementary__card-price">
            {% if product.compare_at_price > product.price %}
              <span class="compare-at-price">{{ product.compare_at_price | money }}</span>
            {% endif %}
            {{ product.price | money }}
          </p>
        </a>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Complementary products",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complimentary customisation"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Link URL"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Complementary products",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
