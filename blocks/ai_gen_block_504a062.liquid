      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "subheadline_size",
      "label": "Subheadline size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Button text",
      "default": "SHOP NEW"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "primary_button_bg",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "primary_button_text_color",
      "label": "Text color",
      "default": "#f7f3eb"
    },
    {
      "type": "color",
      "id": "primary_button_hover_bg",
      "label": "Hover background color",
      "default": "#3B2314"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Button text",
      "default": "EXPLORE COLLECTIONS"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "secondary_button_text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "secondary_button_border",
      "label": "Border color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "secondary_button_hover_bg",
      "label": "Hover background color",
      "default": "#1a1a1a1a"
    },
    {
      "type": "color",
      "id": "secondary_button_hover_border",
      "label": "Hover border color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
