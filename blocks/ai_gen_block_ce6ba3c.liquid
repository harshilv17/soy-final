{% doc %}
  @prompt
    Create a "Tailored for You" section to be placed on product pages after the product details. The section should have:
    - A thin horizontal divider line at the top center
    - A heading in italic serif font: "Tailored for You"
    - A bold subheading: "Bespeak services, included."
    - A body paragraph in a lighter gray color: "Experience the ultimate luxury of a perfect fit. We offer complimentary customization to your exact measurements for every order."
    - Light/cream background color (off-white like #F5F3EE)
    - Centered text alignment
    - Clean, elegant, minimal layout with generous padding
    All text and colors should be customizable via theme settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tailored-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    text-align: center;
  }

  .ai-tailored-divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_thickness }}px;
    background-color: {{ block.settings.divider_color }};
    margin: 0 auto {{ block.settings.divider_spacing }}px;
  }

  .ai-tailored-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.3;
  }

  .ai-tailored-subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    line-height: 1.4;
  }

  .ai-tailored-body-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-style: {{ block.settings.body_font.style }};
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    margin: 0;
    line-height: 1.6;
    max-width: {{ block.settings.body_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  @media screen and (max-width: 749px) {
    .ai-tailored-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-tailored-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-tailored-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-tailored-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-tailored-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_divider %}
    <div class="ai-tailored-divider-{{ ai_gen_id }}"></div>
  {% endif %}

  {% if block.settings.heading != blank %}
    <h2 class="ai-tailored-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.subheading != blank %}
    <p class="ai-tailored-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
  {% endif %}

  {% if block.settings.body_text != blank %}
    <div class="ai-tailored-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
  {% endif %}
</div>

