      "options": [
        { "value": "truck", "label": "Truck" },
        { "value": "scissors", "label": "Scissors" },
        { "value": "shield", "label": "Shield" },
        { "value": "return", "label": "Return" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "clock", "label": "Clock" }
      ],
      "default": "truck"
    },
    {
      "type": "text",
      "id": "row1_text",
      "label": "Text",
      "default": "Ships in 4 days"
    },
    {
      "type": "header",
      "content": "Row 2"
    },
    {
      "type": "select",
      "id": "row2_icon",
      "label": "Icon",
      "options": [
        { "value": "truck", "label": "Truck" },
        { "value": "scissors", "label": "Scissors" },
        { "value": "shield", "label": "Shield" },
        { "value": "return", "label": "Return" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "clock", "label": "Clock" }
      ],
      "default": "scissors"
    },
    {
      "type": "text",
      "id": "row2_text",
      "label": "Text",
      "default": "Free customisation"
    },
    {
      "type": "header",
      "content": "Row 3"
    },
    {
      "type": "select",
      "id": "row3_icon",
      "label": "Icon",
      "options": [
        { "value": "truck", "label": "Truck" },
        { "value": "scissors", "label": "Scissors" },
        { "value": "shield", "label": "Shield" },
        { "value": "return", "label": "Return" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "clock", "label": "Clock" }
      ],
      "default": "shield"
    },
    {
      "type": "text",
      "id": "row3_text",
      "label": "Text",
      "default": "Tailored before dispatch"
    }
  ],
  "presets": [
    {
      "name": "Delivery badge",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
