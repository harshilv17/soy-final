{%- liquid
  assign s = block.settings
  assign product = closest.product
-%}

{%- capture icon_truck -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h13v13H1z"/><path d="M14 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
{%- endcapture -%}
{%- capture icon_scissors -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
{%- endcapture -%}
{%- capture icon_shield -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/></svg>
{%- endcapture -%}
{%- capture icon_return -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M3 13a9 9 0 1 0 3-7.5L3 8"/></svg>
{%- endcapture -%}
{%- capture icon_leaf -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
{%- endcapture -%}
{%- capture icon_clock -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
{%- endcapture -%}

{%- assign rows = '' -%}
{%- if s.row1_text != blank %}{% assign rows = rows | append: '1' %}{% endif -%}
{%- if s.row2_text != blank %}{% assign rows = rows | append: '2' %}{% endif -%}
{%- if s.row3_text != blank %}{% assign rows = rows | append: '3' %}{% endif -%}

{%- if rows != blank and product.available -%}
  <ul class="soy-assurance" role="list" {{ block.shopify_attributes }}>
    {%- for n in (1..3) -%}
      {%- liquid
        assign text = s['row' | append: n | append: '_text']
        assign icon_key = s['row' | append: n | append: '_icon']
      -%}
      {%- if text != blank -%}
        <li class="soy-assurance__row">
          <span class="soy-assurance__icon" aria-hidden="true">
            {%- case icon_key -%}
              {%- when 'scissors' -%}{{ icon_scissors }}
              {%- when 'shield' -%}{{ icon_shield }}
              {%- when 'return' -%}{{ icon_return }}
              {%- when 'leaf' -%}{{ icon_leaf }}
              {%- when 'clock' -%}{{ icon_clock }}
              {%- else -%}{{ icon_truck }}
            {%- endcase -%}
          </span>
          <span class="soy-assurance__text">{{ text }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .soy-assurance {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .soy-assurance__row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.8125rem;
    color: var(--color-foreground);
  }

  .soy-assurance__icon {
    display: inline-flex;
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    color: #c28e6b;
  }

  .soy-assurance__icon svg {
    width: 100%;
    height: 100%;
  }

  .soy-assurance__text strong {
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Delivery badge",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Row 1"
    },
    {
