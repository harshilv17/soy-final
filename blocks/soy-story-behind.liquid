{% doc %}
  @prompt
    "The Story Behind Your Piece" section — a 3-column editorial grid showing the craft process.
    Each column has a portrait-ratio image (or placeholder) with a gradient overlay, a small
    uppercase terracotta label, and a one-line description underneath on a warm taupe background.
    Fully configurable via the theme editor (images, labels, descriptions, heading).
    Background is #f7f3eb, text is dark (#1a1a1a), accent is #c28e6b.
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign bid = block.id | replace: '_', '' | downcase
-%}

{% style %}
  .soy-story-{{ bid }} {
    background: {{ s.bg_color }};
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    border-top: 0.5px solid rgba(26, 26, 26, 0.06);
    border-bottom: 0.5px solid rgba(26, 26, 26, 0.06);
    width: 100%;
    box-sizing: border-box;
  }

  .soy-story__heading-{{ bid }} {
    font-family: var(--font-accent--family);
    font-weight: 300;
    font-size: {{ s.heading_size }}px;
    text-align: center;
    color: #1a1a1a;
    margin: 0 0 22px;
    line-height: 1.3;
  }

  .soy-story__heading-{{ bid }} em {
    font-style: italic;
    color: #c28e6b;
  }

  .soy-story__grid-{{ bid }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    max-width: 900px;
    margin: 0 auto;
  }

  .soy-story__col-{{ bid }} {
    display: flex;
    flex-direction: column;
  }

  .soy-story__img-wrap-{{ bid }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 6px 6px 0 0;
    overflow: hidden;
    position: relative;
    background: linear-gradient(160deg, #d4c5b0 0%, #bfaa8e 100%);
  }

  .soy-story__img-wrap-{{ bid }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .soy-story__overlay-{{ bid }} {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26, 18, 8, 0.35) 0%, transparent 55%);
  }

  .soy-story__text-{{ bid }} {
    background: #e8e0d4;
    border-radius: 0 0 6px 6px;
    padding: 10px 8px 14px;
    flex: 1;
  }

  .soy-story__label-{{ bid }} {
    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c28e6b;
    margin: 0 0 4px;
  }

  .soy-story__desc-{{ bid }} {
    font-family: var(--font-body--family);
    font-size: 11px;
    line-height: 1.55;
    color: #1a1a1a;
    opacity: 0.75;
    margin: 0;
  }
{% endstyle %}

<div class="soy-story-{{ bid }}" {{ block.shopify_attributes }}>
  {% if s.heading != blank %}
    <h2 class="soy-story__heading-{{ bid }}">{{ s.heading }}</h2>
  {% endif %}

  <div class="soy-story__grid-{{ bid }}">

    {%- comment -%} Step 1 {%- endcomment -%}
    <div class="soy-story__col-{{ bid }}">
      <div class="soy-story__img-wrap-{{ bid }}">
        {% if s.image_1 != blank %}
          {%- assign alt_1 = s.label_1 | escape -%}
          {{
            s.image_1
            | image_url: width: 600
            | image_tag:
              loading: 'lazy',
              widths: '200, 300, 400, 600',
              sizes: '(min-width: 750px) 200px, 30vw',
              alt: alt_1
          }}
        {% endif %}
        <div class="soy-story__overlay-{{ bid }}"></div>
      </div>
      <div class="soy-story__text-{{ bid }}">
        {% if s.label_1 != blank %}<p class="soy-story__label-{{ bid }}">{{ s.label_1 | escape }}</p>{% endif %}
        {% if s.desc_1 != blank %}<p class="soy-story__desc-{{ bid }}">{{ s.desc_1 | escape }}</p>{% endif %}
      </div>
    </div>

    {%- comment -%} Step 2 {%- endcomment -%}
    <div class="soy-story__col-{{ bid }}">
      <div class="soy-story__img-wrap-{{ bid }}">
        {% if s.image_2 != blank %}
          {%- assign alt_2 = s.label_2 | escape -%}
          {{
            s.image_2
            | image_url: width: 600
            | image_tag:
              loading: 'lazy',
              widths: '200, 300, 400, 600',
              sizes: '(min-width: 750px) 200px, 30vw',
              alt: alt_2
          }}
        {% endif %}
        <div class="soy-story__overlay-{{ bid }}"></div>
      </div>
      <div class="soy-story__text-{{ bid }}">
        {% if s.label_2 != blank %}<p class="soy-story__label-{{ bid }}">{{ s.label_2 | escape }}</p>{% endif %}
        {% if s.desc_2 != blank %}<p class="soy-story__desc-{{ bid }}">{{ s.desc_2 | escape }}</p>{% endif %}
      </div>
    </div>

    {%- comment -%} Step 3 {%- endcomment -%}
    <div class="soy-story__col-{{ bid }}">
      <div class="soy-story__img-wrap-{{ bid }}">
        {% if s.image_3 != blank %}
          {%- assign alt_3 = s.label_3 | escape -%}
          {{
            s.image_3
            | image_url: width: 600
            | image_tag:
              loading: 'lazy',
              widths: '200, 300, 400, 600',
              sizes: '(min-width: 750px) 200px, 30vw',
              alt: alt_3
          }}
        {% endif %}
        <div class="soy-story__overlay-{{ bid }}"></div>
      </div>
      <div class="soy-story__text-{{ bid }}">
        {% if s.label_3 != blank %}<p class="soy-story__label-{{ bid }}">{{ s.label_3 | escape }}</p>{% endif %}
        {% if s.desc_3 != blank %}<p class="soy-story__desc-{{ bid }}">{{ s.desc_3 | escape }}</p>{% endif %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Story behind your piece",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Story Behind Your Piece",
      "info": "Use the theme editor to set the text. Italic accent styling is applied automatically to the last two words."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f7f3eb"
    },
    {
      "type": "header",
      "content": "Step 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Label",
      "default": "The Wax"
    },
    {
      "type": "text",
      "id": "desc_1",
      "label": "Description",
      "default": "Drawn by hand, line by line."
    },
    {
      "type": "header",
      "content": "Step 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Label",
      "default": "The Dye"
    },
    {
      "type": "text",
      "id": "desc_2",
      "label": "Description",
      "default": "Colour builds slowly, naturally."
    },
    {
      "type": "header",
      "content": "Step 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Label",
      "default": "Your Piece"
    },
    {
      "type": "text",
      "id": "desc_3",
      "label": "Description",
      "default": "Unique. No two alike."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Story behind your piece",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
