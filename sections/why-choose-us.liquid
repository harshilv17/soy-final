<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="why-choose-us section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="why-choose-us__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="why-choose-us__heading">
        <span class="why-choose-us__heading-primary">{{ section.settings.heading | escape }}</span>
        {% if section.settings.heading_script != blank %}
          <span class="why-choose-us__heading-script">{{ section.settings.heading_script | escape }}</span>
        {% endif %}
      </h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="why-choose-us__subheading">{{ section.settings.subheading | escape }}</p>
    {% endif %}

    <div class="why-choose-us__grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'feature' %}
            <div class="why-choose-us__card" {{ block.shopify_attributes }}>
              <div class="why-choose-us__card-icon">
                {% if block.settings.asset_filename != blank %}
                  <img
                    class="why-choose-us__icon-image"
                    src="{{ block.settings.asset_filename | asset_url }}"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    width="120"
                    height="120"
                  >
                {% elsif block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 400
                    | image_tag:
                      loading: 'lazy',
                      widths: '120, 200, 400',
                      sizes: '120px',
                      class: 'why-choose-us__icon-image',
                      alt: block.settings.image.alt | default: block.settings.title | escape
                  }}
                {% else %}
                  {% case forloop.index %}
                    {% when 1 %}
                      <svg class="why-choose-us__icon-svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 10 C14 14 10 18 12 24 C14 30 20 32 24 28"/>
                        <path d="M24 28 C26 24 30 20 34 22 C38 24 38 30 34 34 C30 38 24 38 20 34"/>
                        <path d="M16 16 Q20 12 26 16 Q30 20 26 26"/>
                        <circle cx="32" cy="14" r="2"/>
                        <path d="M30 16 L34 12"/>
                      </svg>
                    {% when 2 %}
                      <svg class="why-choose-us__icon-svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 24 L10 12 L24 6 L38 12 L38 24 C38 34 24 42 24 42 C24 42 10 34 10 24Z"/>
                        <polyline points="18,24 22,28 30,20"/>
                      </svg>
                    {% when 3 %}
                      <svg class="why-choose-us__icon-svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="22" cy="22" r="14"/>
                        <path d="M8 22 Q16 16 22 22 Q28 28 36 22"/>
                        <path d="M22 8 Q18 16 22 22 Q26 28 22 36"/>
                        <line x1="8" y1="22" x2="36" y2="22"/>
                        <rect x="30" y="28" width="12" height="8" rx="2"/>
                        <circle cx="32" cy="36" r="2"/>
                        <circle cx="40" cy="36" r="2"/>
                        <path d="M36 28 L36 24 L42 24 L42 28"/>
                      </svg>
                    {% else %}
                      <svg class="why-choose-us__icon-svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 14 L24 8 L38 14 L38 28 C38 36 24 42 24 42 C24 42 10 36 10 28 Z"/>
                        <polyline points="18,22 22,26 30,18"/>
                        <path d="M30 10 L38 14"/>
                      </svg>
                  {% endcase %}
                {% endif %}
              </div>
              <div class="why-choose-us__card-content">
                {% if block.settings.eyebrow != blank %}
                  <span class="why-choose-us__eyebrow">{{ block.settings.eyebrow | escape }}</span>
                {% endif %}
                {% if block.settings.title != blank %}
                  <h3 class="why-choose-us__title">{{ block.settings.title | escape }}</h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="why-choose-us__text">{{ block.settings.text | escape }}</p>
                {% endif %}
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .why-choose-us__inner {
    max-width: var(--normal-page-width);
    margin-inline: auto;
  }

  .why-choose-us__heading {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1em;
    font: inherit;
    text-align: center;
  }

  .why-choose-us__heading-primary {
    font-family: var(--font-body--family);
    font-size: clamp(0.875rem, 2.2vw, 1.375rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-heading);
    line-height: 1.2;
  }

  .why-choose-us__heading-script {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(1.75rem, 5.5vw, 3rem);
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-primary);
    line-height: 1.1;
  }

  .why-choose-us__subheading {
    margin: var(--padding-sm) auto 0;
    max-width: 36rem;
    text-align: center;
    font-size: var(--font-size--md);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-85));
    line-height: var(--line-height--body-normal);
  }

  /* Card Grid */

  .why-choose-us__grid {
    margin-block-start: var(--padding-xl);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--padding-md);
  }

  @media screen and (min-width: 750px) {
    .why-choose-us__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .why-choose-us__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--padding-lg);
    }
  }

  .why-choose-us__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--padding-xl) var(--padding-lg);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    border-radius: var(--style-border-radius-cards, 12px);
    transition: border-color 0.2s ease;
  }

  .why-choose-us__card:hover {
    border-color: rgb(var(--color-foreground-rgb) / 0.18);
  }

  /* Icon */

  .why-choose-us__card-icon {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-block-end: var(--padding-lg);
    border-radius: 50%;
    background: rgb(var(--color-primary-rgb, 194 142 107) / 0.10);
    color: var(--color-primary);
  }

  .why-choose-us__icon-image {
    width: 110%;
    height: 110%;
    object-fit: contain;
    border-radius: 50%;
    mix-blend-mode: multiply;
  }

  .why-choose-us__icon-svg {
    width: 44px;
    height: 44px;
  }

  /* Content */

  .why-choose-us__card-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .why-choose-us__eyebrow {
    font-family: var(--font-body--family);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .why-choose-us__title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--color-foreground-heading);
  }

  .why-choose-us__text {
    margin: 0;
    font-size: var(--font-size--sm);
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  @media (prefers-reduced-motion: reduce) {
    .why-choose-us__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.why_choose_us",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Why Choose"
    },
    {
      "type": "text",
      "id": "heading_script",
      "label": "Script heading",
      "default": "Shades of You",
      "info": "Displayed in cursive accent font"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:settings.subheading",
      "default": "Thoughtfully made batik, honest service, and a shopping experience you can trust."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:names.value_point",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "asset_filename",
          "label": "Asset filename",
          "info": "e.g. soy-wcu-handmade.png — overrides the image picker above"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "info": "Small label above the title"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.heading",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:settings.text",
          "default": "Describe this value proposition to your customers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.why_choose_us",
      "blocks": {
        "f1": {
          "type": "feature",
          "settings": {
            "eyebrow": "Handcrafted",
            "title": "100% Organic Fabrics",
            "text": "Every piece uses hand-dyed organic cotton and natural fibres — gentle on your skin, kinder to the planet."
          }
        },
        "f2": {
          "type": "feature",
          "settings": {
            "eyebrow": "Hassle-free",
            "title": "Easy Returns & Free Shipping",
            "text": "Complimentary delivery on all orders, with simple returns if your piece isn't quite right."
          }
        },
        "f3": {
          "type": "feature",
          "settings": {
            "eyebrow": "Trusted",
            "title": "Secure & Transparent",
            "text": "Encrypted payments, honest pricing, and a team that's here for you before and after your order."
          }
        }
      },
      "block_order": ["f1", "f2", "f3"]
    }
  ]
}
{% endschema %}
