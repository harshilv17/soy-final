<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="social-proof section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="social-proof__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="social-proof__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.accent_line != blank %}
      <p class="social-proof__accent">
        <em class="social-proof__accent-em">{{ section.settings.accent_line | escape }}</em>
      </p>
    {% endif %}

    {% if section.settings.show_rating %}
      <div
        class="social-proof__rating-row"
        role="group"
        aria-label="{{ section.settings.rating_accessible_label | default: 'Customer rating' | escape }}"
      >
        <span class="social-proof__stars" aria-hidden="true">★★★★★</span>
        <span class="social-proof__score">
          {{- section.settings.rating_value | escape -}}
          {%- if section.settings.rating_suffix != blank -%}
            <span class="social-proof__suffix">{{ section.settings.rating_suffix | escape }}</span>
          {%- endif -%}
        </span>
      </div>
    {% endif %}

    {% if section.settings.trust_line != blank %}
      <p class="social-proof__trust">{{ section.settings.trust_line | escape }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="social-proof__cards" role="list">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'testimonial' %}
              <article class="social-proof__card color-{{ section.settings.card_color_scheme }}" role="listitem" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <div class="social-proof__photo">
                    {{
                      block.settings.image
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        widths: '120, 200, 400',
                        sizes: '(min-width: 750px) 160px, 40vw',
                        class: 'social-proof__img',
                        alt: block.settings.image.alt | default: block.settings.author | escape
                    }}
                  </div>
                {% endif %}
                {% if block.settings.quote != blank %}
                  <blockquote class="social-proof__quote">
                    <p>{{ block.settings.quote | escape }}</p>
                  </blockquote>
                {% endif %}
                {% if block.settings.author != blank %}
                  <footer class="social-proof__cite">
                    <cite class="social-proof__author">{{ block.settings.author | escape }}</cite>
                    {% if block.settings.author_detail != blank %}
                      <span class="social-proof__detail">{{ block.settings.author_detail | escape }}</span>
                    {% endif %}
                  </footer>
                {% endif %}
              </article>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .social-proof__inner {
    max-width: var(--normal-page-width);
    margin-inline: auto;
  }

  .social-proof__heading {
    margin: 0;
    text-align: center;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-heading);
  }

  .social-proof__accent {
    margin: var(--padding-sm) auto 0;
    text-align: center;
    font-size: var(--font-size--lg);
    color: var(--color-foreground);
  }

  .social-proof__accent-em {
    color: var(--color-primary);
    font-style: italic;
    font-weight: 500;
  }

  .social-proof__rating-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--padding-sm);
    margin-block-start: var(--padding-lg);
  }

  .social-proof__stars {
    font-size: 1.125rem;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    line-height: 1;
  }

  .social-proof__score {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--2xl);
    font-weight: 400;
    color: var(--color-foreground-heading);
  }

  .social-proof__suffix {
    font-size: 0.65em;
    opacity: 0.85;
    margin-inline-start: 0.15em;
  }

  .social-proof__trust {
    margin: var(--padding-md) auto 0;
    text-align: center;
    font-size: var(--font-size--sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-85));
    max-width: 28rem;
  }

  .social-proof__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--padding-md);
    margin-block-start: var(--padding-xl);
  }

  @media screen and (min-width: 750px) {
    .social-proof__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .social-proof__card {
    display: flex;
    flex-direction: column;
    padding: var(--padding-lg);
    border-radius: var(--style-border-radius-cards, 12px);
    border: 1px solid rgb(var(--color-border-rgb) / 0.4);
    box-shadow: 0 8px 24px rgb(var(--color-shadow-rgb) / 0.05);
  }

  .social-proof__photo {
    width: 100%;
    max-width: 160px;
    margin-inline: auto;
    margin-block-end: var(--padding-md);
    border-radius: var(--style-border-radius-md);
    overflow: hidden;
    aspect-ratio: 1;
  }

  .social-proof__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .social-proof__quote {
    margin: 0;
    flex: 1;
  }

  .social-proof__quote p {
    margin: 0;
    font-size: var(--font-size--md);
    line-height: var(--line-height--body-loose);
    color: var(--color-foreground);
    font-style: italic;
  }

  .social-proof__cite {
    margin-block-start: var(--padding-md);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: var(--font-size--sm);
    font-style: normal;
  }

  .social-proof__author {
    font-style: normal;
    font-weight: 600;
    color: var(--color-foreground-heading);
  }

  .social-proof__detail {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: var(--font-size--xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.social_proof",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Loved by real wardrobes"
    },
    {
      "type": "text",
      "id": "accent_line",
      "label": "t:settings.subheading",
      "default": "Real voices"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:settings.show_rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "t:settings.rating_score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_suffix",
      "label": "t:settings.rating_out_of",
      "default": "/ 5"
    },
    {
      "type": "text",
      "id": "rating_accessible_label",
      "label": "t:settings.rating_accessible_label",
      "default": "Average customer rating 4.8 out of 5 stars",
      "info": "t:info.rating_accessible_label"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "t:settings.trust_line",
      "default": "Loved by 10,000+ customers"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "t:settings.card_color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:names.customer_review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:settings.text",
          "default": "The fabric feels incredible—I've worn my kurta to work and dinner."
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:settings.author",
          "default": "Priya M."
        },
        {
          "type": "text",
          "id": "author_detail",
          "label": "t:settings.author_info",
          "default": "Verified buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.social_proof",
      "blocks": {
        "t1": {
          "type": "testimonial",
          "settings": {
            "quote": "Soft batik that actually breathes—my go-to for Singapore heat.",
            "author": "Aisha K.",
            "author_detail": "Verified buyer"
          }
        },
        "t2": {
          "type": "testimonial",
          "settings": {
            "quote": "Feels special without being fussy. Compliments every time I wear it.",
            "author": "Mei L.",
            "author_detail": "Repeat customer"
          }
        },
        "t3": {
          "type": "testimonial",
          "settings": {
            "quote": "Packaging and craft both feel thoughtful. Worth the wait.",
            "author": "Daniel R.",
            "author_detail": "First order"
          }
        }
      },
      "block_order": ["t1", "t2", "t3"]
    }
  ]
}
{% endschema %}
