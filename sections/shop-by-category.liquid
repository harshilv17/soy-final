<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="shop-by-category section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="shop-by-category__inner page-width">
    <h2 class="shop-by-category__heading">
      <span class="shop-by-category__heading-primary">{{ section.settings.title | escape }}</span>
      {% if section.settings.subtitle != blank %}
        <span class="shop-by-category__heading-script">{{ section.settings.subtitle | escape }}</span>
      {% endif %}
    </h2>

    <div class="shop-by-category__grid" role="list">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'category' %}
            <div class="shop-by-category__item" role="listitem" {{ block.shopify_attributes }}>
              {% render 'category-card',
                title: block.settings.label,
                icon: block.settings.icon_svg,
                image: block.settings.image,
                link: block.settings.link
              %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .shop-by-category__heading {
    margin: 0 0 var(--padding-lg);
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.4em;
    padding-inline: var(--padding-xs);
    font: inherit;
  }

  .shop-by-category__heading-primary {
    font-family: var(--font-body--family);
    font-size: clamp(0.875rem, 2.2vw, 1.375rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-heading);
    white-space: nowrap;
    flex: 0 1 auto;
    line-height: 1.2;
  }

  .shop-by-category__heading-script {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(1.375rem, 4.5vw, 2rem);
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-primary);
    white-space: nowrap;
    flex: 0 0 auto;
    line-height: 1;
  }

  .shop-by-category__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--padding-md);
    justify-items: center;
  }

  /* Category card component */

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--padding-xs, 0.75rem);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .category-card:focus-visible {
    outline: var(--focus-outline-width, 2px) solid var(--color-primary);
    outline-offset: 4px;
    border-radius: var(--style-border-radius-cards, 8px);
  }

  .category-card__circle {
    --category-circle-size: clamp(60px, 12vw, 120px);

    width: var(--category-circle-size);
    height: var(--category-circle-size);
    border-radius: 50%;
    background: rgb(var(--color-foreground-rgb) / 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: transform 0.25s ease;
  }

  .category-card:hover .category-card__circle {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card__circle {
      transition: none;
    }
  }

  .category-card__circle svg {
    width: 40%;
    height: 40%;
    color: var(--color-foreground);
  }

  .category-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .category-card__placeholder {
    width: 50%;
    height: 50%;
    opacity: 0.4;
  }

  .category-card__label {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 0.875rem);
    font-weight: 500;
    text-align: center;
    color: var(--color-foreground);
    line-height: 1.3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "default": "Shop By"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:settings.subheading",
      "default": "Category"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.text",
          "default": "Category"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG",
          "info": "Paste inline SVG markup. Takes priority over image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": {
        "cat_1": {
          "type": "category",
          "settings": { "label": "Kurtas" }
        },
        "cat_2": {
          "type": "category",
          "settings": { "label": "Sets" }
        },
        "cat_3": {
          "type": "category",
          "settings": { "label": "Dupattas" }
        },
        "cat_4": {
          "type": "category",
          "settings": { "label": "Bottoms" }
        },
        "cat_5": {
          "type": "category",
          "settings": { "label": "Accessories" }
        }
      },
      "block_order": ["cat_1", "cat_2", "cat_3", "cat_4", "cat_5"]
    }
  ]
}
{% endschema %}
